has_timeouts: true
attributes:
    - name: cidr_block
      type: StringAttribute
      optional: true
      validators:
        - validators.CIDRBlockValidator
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: cloud_provider
      type: StringAttribute
      required: true
      validators:
        - stringvalidator.oneOfValidator
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: cluster_type
      type: StringAttribute
      required: true
      validators:
        - stringvalidator.oneOfValidator
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: customer_managed_resources
      type: SingleNestedAttribute
      optional: true
      attributes:
        - name: aws
          type: SingleNestedAttribute
          optional: true
          attributes:
            - name: dynamodb_table
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: arn
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
            - name: management_bucket
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: arn
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
            - name: private_subnets
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: arns
                  type: ListAttribute
                  required: true
                  validators:
                    - listvalidator.uniqueValuesValidator
                  plan_modifiers:
                    - listplanmodifier.requiresReplaceIfModifier
                  element_type: basetypes.StringType
            - name: public_subnets
              type: SingleNestedAttribute
              optional: true
              computed: true
              plan_modifiers:
                - network.publicSubnetsWriteOnceModifier
              attributes:
                - name: arns
                  type: ListAttribute
                  required: true
                  validators:
                    - listvalidator.uniqueValuesValidator
                  element_type: basetypes.StringType
            - name: vpc
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: arn
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
        - name: azure
          type: SingleNestedAttribute
          optional: true
          attributes:
            - name: management_bucket
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: resource_group
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: storage_account_name
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
                - name: storage_container_name
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
            - name: subnets
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: kafka_connect_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: kafka_connect_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_0_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_0_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_1_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_1_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_2_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_2_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_agent
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_connect_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_connect_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: rp_egress_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: sys_pods
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
                - name: sys_vnet
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
            - name: vnet
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: name
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
                - name: resource_group
                  type: SingleNestedAttribute
                  required: true
                  attributes:
                    - name: name
                      type: StringAttribute
                      required: true
                      plan_modifiers:
                        - stringplanmodifier.requiresReplaceIfModifier
        - name: gcp
          type: SingleNestedAttribute
          optional: true
          attributes:
            - name: management_bucket
              type: SingleNestedAttribute
              required: true
              attributes:
                - name: name
                  type: StringAttribute
                  required: true
                  plan_modifiers:
                    - stringplanmodifier.requiresReplaceIfModifier
            - name: network_name
              type: StringAttribute
              required: true
              validators:
                - stringvalidator.regexMatchesValidator
                - stringvalidator.lengthAtMostValidator
              plan_modifiers:
                - stringplanmodifier.requiresReplaceIfModifier
            - name: network_project_id
              type: StringAttribute
              required: true
              validators:
                - stringvalidator.regexMatchesValidator
                - stringvalidator.lengthAtMostValidator
              plan_modifiers:
                - stringplanmodifier.requiresReplaceIfModifier
    - name: egress_spec
      type: SingleNestedAttribute
      optional: true
      attributes:
        - name: aws
          type: SingleNestedAttribute
          optional: true
          plan_modifiers:
            - objectplanmodifier.requiresReplaceIfModifier
          attributes:
            - name: transit_gateway_id
              type: StringAttribute
              required: true
              validators:
                - stringvalidator.regexMatchesValidator
        - name: azure
          type: SingleNestedAttribute
          optional: true
          plan_modifiers:
            - objectplanmodifier.requiresReplaceIfModifier
          attributes:
            - name: firewall_private_ip
              type: StringAttribute
              required: true
              validators:
                - validators.IPAddressValidator
            - name: hub_vnet_id
              type: StringAttribute
              required: true
        - name: gcp
          type: SingleNestedAttribute
          optional: true
          plan_modifiers:
            - objectplanmodifier.requiresReplaceIfModifier
          attributes:
            - name: hub_vpc_name
              type: StringAttribute
              required: true
              validators:
                - stringvalidator.regexMatchesValidator
                - stringvalidator.lengthAtMostValidator
            - name: hub_vpc_project
              type: StringAttribute
              required: true
              validators:
                - stringvalidator.regexMatchesValidator
                - stringvalidator.lengthAtMostValidator
    - name: id
      type: StringAttribute
      computed: true
      plan_modifiers:
        - stringplanmodifier.useStateForUnknownModifier
    - name: name
      type: StringAttribute
      required: true
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: region
      type: StringAttribute
      required: true
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: resource_group_id
      type: StringAttribute
      required: true
      plan_modifiers:
        - stringplanmodifier.requiresReplaceIfModifier
    - name: state
      type: StringAttribute
      computed: true
      plan_modifiers:
        - stringplanmodifier.useStateForUnknownModifier
    - name: zones
      type: ListAttribute
      computed: true
      plan_modifiers:
        - listplanmodifier.useStateForUnknownModifier
      element_type: basetypes.StringType
