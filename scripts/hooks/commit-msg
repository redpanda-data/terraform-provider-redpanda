#!/usr/bin/env bash
# commit-msg hook: enforces the commit message policy in CLAUDE.md.
set -euo pipefail

msg_file="$1"
# git commit -v appends the diff below the scissors line and strips it only
# after this hook runs, so everything from that line on is not the message.
scissors='# ------------------------ >8 ------------------------'
msg=$(sed -n "/^${scissors}\$/q;p" "$msg_file")
title=$(printf '%s\n' "$msg" | grep -v '^#' | sed -n '1p')

case "$title" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() { echo "commit-msg: $1" >&2; echo "  title: $title" >&2; exit 1; }

[[ "$title" =~ ^(feat|fix|test|docs|chore|ci|agent)\([a-z0-9_/-]+\)!?:\ .+$ ]] \
  || fail "title must be 'type(scope): summary' with a scope and type in feat|fix|test|docs|chore|ci|agent"
desc="${title#*: }"
[[ "$desc" =~ ^[a-z0-9] ]] || fail "summary must start lowercase"
[[ "$desc" != *. ]] || fail "summary must not end with a period"
[ ${#title} -le 72 ] || fail "title is ${#title} characters; limit is 72"

if printf '%s\n' "$msg" | grep -v '^#' | grep -qE '\b(ENG|K8S|CORE|DEVEX|OPS)-[0-9]+\b'; then
  fail "no ticket IDs in commit messages"
fi
